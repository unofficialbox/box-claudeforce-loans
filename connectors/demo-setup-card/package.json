{
  "name": "los-demo-setup-card",
  "version": "0.1.0",
  "private": true,
  "description": "MCP Apps connector that renders the LOS demo's Demo Setup decision card inside Claude Desktop.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.server.json && cross-env INPUT=mcp-app.html vite build",
    "start": "node dist/server/main.js",
    "start:http": "cross-env MCP_TRANSPORT=http node dist/server/main.js",
    "dev": "concurrently --raw \"cross-env INPUT=mcp-app.html vite build --watch\" \"tsx watch src/main.ts\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^3.0.0"
  }
}
